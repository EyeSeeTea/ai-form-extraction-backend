NODE_ENV=development
SERVICE_NAME=ai-form-extraction-backend
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_PATH=./app.sqlite
CORS_ORIGIN=*
AUTH_TOKEN=change-me
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000
UPLOADS_DIR=./uploads
UPLOAD_MAX_FILES=5
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
UPLOAD_RETENTION_MS=604800000
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
