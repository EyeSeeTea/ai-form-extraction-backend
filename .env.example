NODE_ENV=development
SERVICE_NAME=ai-form-extraction-backend
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_PATH=./app.sqlite
CORS_ORIGIN=*
AUTH_TOKEN=change-me
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000
UPLOADS_DIR=./uploads
UPLOAD_MAX_FILES=5
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
PDF_MAX_PAGES=20
PDF_MAX_EXTRACTED_IMAGES=20
LLM_PROVIDER=stub # one of: stub, openrouter, ollama
# Optional external directory containing <encoded-form-label>.json stub-result overrides.
# STUB_RESULTS_DIR=/absolute/path/to/stub-results
OPENROUTER_API_KEY=api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3-vl-32b-instruct
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3-vl:4b
UPLOAD_RETENTION_MS=604800000
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
